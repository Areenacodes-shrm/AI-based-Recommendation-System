# ==============================================================================
# PathPilot AI - Comprehensive .gitignore
# ==============================================================================

# Compiled Java class files
*.class

# Log files
*.log
*.log.*
*.dump
*.dumpstream

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machines
*.vmdk

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle
/build/

# Node & Frontend dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Production builds
dist/
frontend/dist/
build/
backend/src/main/resources/static/assets/
backend/src/main/resources/static/index.html

# Local Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary and Scratch Files
*.tmp
*.bak
*.swp
*~
scratch/
tools/
