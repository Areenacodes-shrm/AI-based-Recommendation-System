# PathPilot AI Environment Configuration Example
# Copy to .env (never commit real secrets or production passwords)

# Server Port
PORT=8080

# Database Configuration (MySQL 8.0)
# To connect to a local MySQL 8.0 instance, configure these values:
# DB_URL=jdbc:mysql://localhost:3306/pathpilot_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_secure_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# Default In-Memory Database (H2 MySQL-mode fallback when MySQL variables are omitted)
DB_URL=jdbc:h2:mem:pathpilot;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# Schema & Seed Initialization Controls
SQL_INIT_MODE=always
SEED_DATA_ENABLED=true
# Optional override for initial local demo student passwords (stored only as PBKDF2-HMAC-SHA256 hash)
# PATHPILOT_DEMO_PASSWORD=change_me_for_local_demo

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SESSION_COOKIE_SECURE=false

# Concurrency & Recommendation Tuning
PATHPILOT_THREAD_POOL_SIZE=8
PATHPILOT_TIMEOUT_MS=2500
