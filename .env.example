# PathPilot AI Environment Configuration Example

# Server Port
PORT=8080

# Database Configuration (MySQL 8.0)
# To connect to a local MySQL 8.0 instance, uncomment and configure:
# DB_URL=jdbc:mysql://localhost:3306/pathpilot_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_secure_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# Fallback in-memory database (default if DB_URL is not set)
DB_URL=jdbc:h2:mem:pathpilot;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# Concurrency & Recommendation Tuning
PATHPILOT_THREAD_POOL_SIZE=8
PATHPILOT_TIMEOUT_MS=2500
